# Copie para .env (não versionado) na VPS.
# Mesmo projeto Supabase da SPA (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Conta SIGES à qual este Hermes está vinculado. O servidor faz login com ela,
# então o RLS e as views security_invoker valem exatamente como no app.
# NÃO use a service_role key aqui.
SIGES_USER_EMAIL=gestor@empresa.com.br
SIGES_USER_PASSWORD=troque-me

# Opcional: máximo de linhas devolvidas por ferramenta (padrão 50)
SIGES_MAX_ROWS=50

# ---------------------------------------------------------------------------
# MODO MULTIUSUÁRIO (um Hermes para todos). Se as duas variáveis abaixo
# estiverem definidas, SIGES_USER_EMAIL/PASSWORD são ignorados: cada chamada
# identifica o remetente do WhatsApp (assinado pelo plugin do Hermes), acha o
# usuário por users.mobile_full e consulta com o RLS dele.
#
# JWT secret do Supabase self-hosted (JWT_SECRET no .env do Supabase).
# É tão poderoso quanto a service_role: mantenha este arquivo com chmod 600.
# SUPABASE_JWT_SECRET=
#
# Segredo compartilhado com o plugin do Hermes (gere com: openssl rand -hex 32).
# SIGES_HOOK_SECRET=
