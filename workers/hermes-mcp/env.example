# Copie para .env (não versionado) na VPS.
# Mesmo projeto Supabase da SPA (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Conta SIGES à qual este Hermes está vinculado. O servidor faz login com ela,
# então o RLS e as views security_invoker valem exatamente como no app.
# NÃO use a service_role key aqui.
SIGES_USER_EMAIL=gestor@empresa.com.br
SIGES_USER_PASSWORD=troque-me

# Opcional: máximo de linhas devolvidas por ferramenta (padrão 50)
SIGES_MAX_ROWS=50
