import React from 'react';
import { IconButton } from './ui/IconButton';

import { User } from '../types';
import { getInitials } from '../utils/formatters';
import { useStatusModal } from '../hooks/useStatusModal';

interface HeaderProps {
    title: string;
    onMenuClick?: () => void;
    showBackButton?: boolean;
    onBackClick?: () => void;
    currentUser?: Partial<User> | null;
    onStatusChange?: (isAvailable: boolean, ovIdInProgress: number) => Promise<void>;
    onNotificationsClick?: () => void;
}

export const Header: React.FC<HeaderProps> = ({
    title,
    onMenuClick,
    showBackButton,
    onBackClick,
    currentUser,
    onStatusChange,
    onNotificationsClick
}) => {

    setIsUpdating(true);
    try {
        const isAvailable = newStatus === 'available';
        await onStatusChange(isAvailable, currentUser.ovIdInProgress || 0);
        setShowStatusModal(false);
    } catch (error) {
        console.error('Erro ao atualizar status:', error);
        alert('Erro ao atualizar status. Tente novamente.');
    } finally {
        setIsUpdating(false);
    }
};

const oppositeStatus = getOppositeStatus();

return (
    <header className="flex items-center px-4 py-4 justify-between bg-surface-light dark:bg-background-dark sticky top-0 z-20 border-b border-slate-200 dark:border-slate-800">
        <div className="flex items-center gap-2 flex-1">
            {showBackButton && onBackClick && (
                <IconButton
                    icon="arrow_back"
                    onClick={onBackClick}
                    className="-ml-2 text-slate-900 dark:text-white"
                />
            )}
            <h1 className="text-slate-900 dark:text-white text-2xl font-bold leading-tight tracking-tight truncate">
                {title}
            </h1>
        </div>

        <div className="flex items-center gap-2">
            {currentUser && (
                <>
                    <button
                        onClick={onNotificationsClick}
                        className="relative flex items-center justify-center w-[34px] h-[34px] text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors"
                        style={{ fontSize: '30px' }}
                    >
                        <span className="material-symbols-outlined" style={{ fontSize: 'inherit', lineHeight: 1 }}>
                            notifications
                        </span>
                        {(currentUser.notificationsAmount || 0) > 0 && (
                            <span className="absolute -top-1 -right-1 min-w-[18px] h-[18px] bg-red-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full border-2 border-white dark:border-background-dark px-1">
                                {currentUser.notificationsAmount}
                            </span>
                        )}
                    </button>

                    <button
                        onClick={() => setShowStatusModal(true)}
                        className="relative hover:opacity-80 transition-opacity"
                    >
                        {currentUser.avatarUrl ? (
                            <img
                                src={currentUser.avatarUrl}
                                alt={currentUser.nameFull || 'Usuário'}
                                className="w-10 h-10 rounded-full object-cover border-2 border-white dark:border-card-dark shadow-sm"
                            />
                        ) : (
                            <div className="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm border-2 border-white dark:border-card-dark shadow-sm">
                                {getInitials(currentUser.nameFull)}
                            </div>
                        )}
                        <span className={`absolute - top - 0.5 - right - 0.5 w - 3.5 h - 3.5 rounded - full border - 2 border - white dark: border - card - dark ${statusConfig[currentStatus].color} `}></span>
                    </button>
                </>
            )}

            {currentUser?.companyId && (
                <div className="flex items-center">
                    {currentUser.companyLogoUrl ? (
                        <img
                            src={currentUser.companyLogoUrl}
                            alt={currentUser.companyName || 'Empresa'}
                            className="w-10 h-10 rounded-full object-cover border-2 border-white dark:border-card-dark shadow-sm bg-white"
                        />
                    ) : (
                        <div className="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center font-bold text-sm border-2 border-white dark:border-card-dark shadow-sm">
                            {getInitials(currentUser.companyName)}
                        </div>
                    )}
                </div>
            )}

            {onMenuClick && (
                <IconButton
                    icon="menu"
                    onClick={onMenuClick}
                    className="text-slate-900 dark:text-white"
                />
            )}
        </div>

        {/* Status Change Modal */}
        {showStatusModal && (
            <div className="fixed inset-0 z-[100] flex items-center justify-center p-4">
                <div
                    className="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"
                    onClick={() => setShowStatusModal(false)}
                />
                <div className="relative w-full max-w-sm bg-white dark:bg-card-dark rounded-3xl shadow-2xl overflow-hidden">
                    <div className="p-6">
                        <div className="flex flex-col items-center text-center">
                            <div className="w-16 h-16 bg-blue-50 dark:bg-blue-900/10 rounded-2xl flex items-center justify-center mb-4">
                                <span className="material-symbols-outlined text-4xl text-primary">
                                    info
                                </span>
                            </div>
                            <h3 className="text-xl font-bold text-slate-900 dark:text-white mb-6">
                                Confirme sua nova Situação
                            </h3>
                        </div>

                        <button
                            onClick={() => handleStatusChange(oppositeStatus)}
                            disabled={isUpdating}
                            className="w-full flex items-center gap-3 p-4 bg-slate-50 dark:bg-slate-800 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed mb-3"
                        >
                            <div className={`w - 4 h - 4 ${statusConfig[oppositeStatus].color} rounded - full`}></div>
                            <div className="flex-1 text-left">
                                <div className="font-semibold text-slate-900 dark:text-white">
                                    {statusConfig[oppositeStatus].label}
                                </div>
                                <div className="text-xs text-slate-500 dark:text-slate-400">
                                    {statusConfig[oppositeStatus].description}
                                </div>
                            </div>
                        </button>

                        <button
                            onClick={() => setShowStatusModal(false)}
                            className="w-full py-3 rounded-xl text-slate-600 dark:text-slate-400 font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                        >
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>
        )}
    </header>
);
};
