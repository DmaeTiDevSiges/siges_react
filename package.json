{
  "name": "siges",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-version.js && vite build",
    "build:android": "node scripts/generate-version.js && vite build --mode android && npx cap sync android",
    "build:android:auto": "node scripts/generate-version.js --auto && vite build --mode android && npx cap sync android",
    "apk": "bash scripts/build-apk.sh",
    "apk:win": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "electron:dev": "vite",
    "electron:build": "npm run build -- --mode electron && electron-builder",
    "lint": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "flow-convert": "npx ts-node flow-convert-cli.ts",
    "db:export": "node scripts/export-database-structure.js",
    "db:export:rest": "node scripts/export-database-structure-rest.js",
    "db:export:rest:complete": "node scripts/export-database-structure-rest-complete.js",
    "db:restore": "node scripts/restore-database.js",
    "db:validate": "node scripts/validate-schema.js",
    "db:backup": "node scripts/full-backup.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.990.0",
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-mlkit/barcode-scanning": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.34.0",
    "@google/generative-ai": "^0.24.1",
    "@ionic/pwa-elements": "^3.3.0",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/supabase-js": "^2.89.0",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-routing-machine": "^3.2.9",
    "@types/leaflet.markercluster": "^1.5.6",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "file-saver": "^2.0.5",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "leaflet.markercluster": "^1.5.3",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-qr-code": "^2.0.18",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.siges.app",
    "productName": "SIGES",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/siges_logo.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/siges_logo.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/siges_logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "jest": "^30.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
